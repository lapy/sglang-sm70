+// sglang-sm70: __tanhf exists in the device ISA only from sm_75. The softcap path below is
+// instantiated even when IS_SOFTCAP is false (the name is non-dependent), so the call has to
+// compile for compute_70. Device tanhf is available on every architecture this library targets.
+__device__ __forceinline__ float sm70_tanhf(float x) {
+#if defined(__CUDA_ARCH__) && (__CUDA_ARCH__ >= 750)
+  return __tanhf(x);
+#else
+  return tanhf(x);
+#endif
+}
 #endif
 
